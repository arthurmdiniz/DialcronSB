<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#8E3B52</Color>
    <Color x:Key="PrimaryDark">#DFA6AF</Color>
    <Color x:Key="PrimaryDarkText">#3B3032</Color>
    <Color x:Key="Secondary">#F5E8E5</Color>
    <Color x:Key="SecondaryDarkText">#DFA6AF</Color>
    <Color x:Key="Tertiary">#C77C8A</Color>

    <Color x:Key="Creme">#FFF8F5</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#3B3032</Color>
    <Color x:Key="Magenta">#C77C8A</Color>
    <Color x:Key="MidnightBlue">#3B3032</Color>
    <Color x:Key="OffBlack">#2F1D23</Color>

    <Color x:Key="Gray100">#F5E8E5</Color>
    <Color x:Key="Gray200">#E7D3D1</Color>
    <Color x:Key="Gray300">#D2B9B7</Color>
    <Color x:Key="Gray400">#B99FA0</Color>
    <Color x:Key="Gray500">#75696B</Color>
    <Color x:Key="Gray600">#5C4B4E</Color>
    <Color x:Key="Gray900">#3B3032</Color>
    <Color x:Key="Gray950">#2F1D23</Color>

    <Color x:Key="DarkBackground">#2F1D23</Color>
    <Color x:Key="DarkSurface">#3B262C</Color>
    <Color x:Key="DarkText">#F5E8E5</Color>
    <Color x:Key="DarkTextSecondary">#DFA6AF</Color>

    <Color x:Key="Sucesso">#72A68A</Color>
    <Color x:Key="Atencao">#D6A84F</Color>
    <Color x:Key="Erro">#C95C62</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>