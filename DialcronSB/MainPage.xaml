<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DialcronSB.MainPage"
             Title="Dialcron">

    <VerticalStackLayout
        Padding="30,40"
        Spacing="20"
        VerticalOptions="Center">

        <Label
            Text="Dialcron"
            Style="{StaticResource Headline}"
            SemanticProperties.HeadingLevel="Level1" />

        <Label
            Text="Sistema de agendamentos"
            Style="{StaticResource SubHeadline}"
            SemanticProperties.HeadingLevel="Level2" />

        <Button
            x:Name="AgendaBtn"
            Text="Agenda"
            FontSize="18"
            Clicked="OnAgendaClicked"
            SemanticProperties.Hint="Abre a agenda de atendimentos"
            HorizontalOptions="Fill" />

        <Button
            x:Name="CadastrosBtn"
            Text="Cadastros"
            FontSize="18"
            Clicked="OnCadastrosClicked"
            SemanticProperties.Hint="Abre o menu de cadastros"
            HorizontalOptions="Fill" />

        <Button
            x:Name="BackupBtn"
            Text="Backup"
            FontSize="18"
            Clicked="OnBackupClicked"
            SemanticProperties.Hint="Gera um backup do banco de dados"
            HorizontalOptions="Fill" />

    </VerticalStackLayout>

</ContentPage>