<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DialcronSB.MainPage"
             Title="Dialcron">

    <VerticalStackLayout
        Padding="30,40"
        Spacing="14"
        VerticalOptions="Center">

        <Image
            Source="logo.png"
            HeightRequest="140"
            WidthRequest="140"
            Aspect="AspectFit"
            HorizontalOptions="Center"
            SemanticProperties.Description="Logotipo do Dialcron" />

        <Label
            Text="Dialcron"
            Style="{StaticResource Headline}"
            SemanticProperties.HeadingLevel="Level1" />

        <Label
            Text="Sistema de agendamentos"
            Style="{StaticResource SubHeadline}"
            SemanticProperties.HeadingLevel="Level2" />

        <Button
            x:Name="AgendaBtn"
            Text="Agenda"
            FontSize="18"
            Clicked="OnAgendaClicked"
            SemanticProperties.Hint="Abre a agenda de atendimentos"
            HorizontalOptions="Fill" />

        <Button
            x:Name="CadastrosBtn"
            Text="Cadastros"
            FontSize="18"
            Clicked="OnCadastrosClicked"
            SemanticProperties.Hint="Abre o menu de cadastros"
            HorizontalOptions="Fill" />

        <Button
            x:Name="ConfiguracoesBtn"
            Text="Configurações"
            FontSize="18"
            Clicked="OnConfiguracoesClicked"
            SemanticProperties.Hint="Abre backup, importacao e atualizacoes"
            HorizontalOptions="Fill" />

    </VerticalStackLayout>

</ContentPage>
