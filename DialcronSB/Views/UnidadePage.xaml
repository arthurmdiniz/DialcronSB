<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DialcronSB.Views.UnidadePage"
             Title="Unidades">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label
                Text="Cadastro de Unidades"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Border
                Padding="16"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSurface}}">
                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="Lista"
                        Style="{StaticResource SubHeadline}"
                        SemanticProperties.HeadingLevel="Level2" />

                    <Grid ColumnDefinitions="60,*" Padding="0,4">
                        <Label Text="ID" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="Nome fantasia" FontAttributes="Bold" />
                    </Grid>

                    <CollectionView
                        x:Name="UnidadesCollection"
                        HeightRequest="160"
                        SelectionMode="Single"
                        SelectionChanged="OnSelecaoChanged"
                        EmptyView="Nenhuma unidade cadastrada">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="60,*" Padding="0,8">
                                    <Label Text="{Binding IdUnidade}" />
                                    <Label Grid.Column="1" Text="{Binding Exibicao}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border
                Padding="16"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSurface}}">
                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="Dados da unidade"
                        Style="{StaticResource SubHeadline}"
                        SemanticProperties.HeadingLevel="Level2" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                            <Label Text="Nome fantasia" />
                            <Entry x:Name="NomeFantasiaEntry" Placeholder="Nome fantasia" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="Razão social" />
                            <Entry x:Name="RazaoSocialEntry" Placeholder="Razão social" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                            <Label Text="CNPJ" />
                            <Entry x:Name="CnpjEntry" Placeholder="CNPJ" Keyboard="Numeric" TextChanged="OnMascaraDocumento" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="Insc. estadual" />
                            <Entry x:Name="InscEstadualEntry" Placeholder="Insc. estadual" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="3">
                            <Label Text="Insc. municipal" />
                            <Entry x:Name="InscMunicipalEntry" Placeholder="Insc. municipal" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,2*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                            <Label Text="CEP" />
                            <Entry x:Name="CepEntry" Placeholder="CEP" Keyboard="Numeric" TextChanged="OnMascaraCep" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="Logradouro" />
                            <Entry x:Name="LogradouroEntry" Placeholder="Logradouro" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="3">
                            <Label Text="Número" />
                            <Entry x:Name="NumeroEntry" Placeholder="Nº" Keyboard="Numeric" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                            <Label Text="Bairro" />
                            <Entry x:Name="BairroEntry" Placeholder="Bairro" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="Complemento" />
                            <Entry x:Name="ComplementoEntry" Placeholder="Complemento" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,2*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                            <Label Text="UF" />
                            <Entry x:Name="UfEntry" Placeholder="UF" MaxLength="2" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="Município" />
                            <Entry x:Name="MunicipioEntry" Placeholder="Município" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="3">
                            <Label Text="País" />
                            <Entry x:Name="PaisEntry" Placeholder="País" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                            <Label Text="E-mail" />
                            <Entry x:Name="EmailEntry" Placeholder="E-mail" Keyboard="Email" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="DDD" />
                            <Entry x:Name="DddEntry" Placeholder="DDD" Keyboard="Numeric" TextChanged="OnMascaraDdd" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="3">
                            <Label Text="Telefone" />
                            <Entry x:Name="TelefoneEntry" Placeholder="Telefone" Keyboard="Telephone" TextChanged="OnMascaraTelefone" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" Margin="0,8,0,0">
                        <Button
                            Grid.Column="0"
                            x:Name="IncluirBtn"
                            Text="Incluir"
                            Clicked="OnIncluirClicked"
                            SemanticProperties.Hint="Prepara uma nova unidade para cadastro" />
                        <Button
                            Grid.Column="1"
                            x:Name="SalvarBtn"
                            Text="Salvar"
                            Clicked="OnSalvarClicked"
                            SemanticProperties.Hint="Salva a unidade informada" />
                        <Button
                            Grid.Column="2"
                            x:Name="ExcluirBtn"
                            Text="Excluir"
                            Clicked="OnExcluirClicked"
                            IsEnabled="False"
                            SemanticProperties.Hint="Exclui a unidade selecionada" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
