<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DialcronSB.Views.UnidadePage"
             Title="Unidades">

    <Grid
        Padding="24"
        ColumnDefinitions="*,*"
        ColumnSpacing="24"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="16">

        <Label
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Text="Cadastro Unidades"
            Style="{StaticResource Headline}"
            SemanticProperties.HeadingLevel="Level1" />

        <Border
            x:Name="ListagemRegistros"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Padding="16"
            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSurface}}">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                <Label
                    Text="Lista"
                    Style="{StaticResource SubHeadline}"
                    HorizontalOptions="Start"
                    HorizontalTextAlignment="Start"
                    SemanticProperties.HeadingLevel="Level2" />

                <Grid
                    Grid.Row="1"
                    ColumnDefinitions="60,*"
                    Padding="0,4">
                    <Label Text="ID" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="Nome" FontAttributes="Bold" />
                </Grid>

                <CollectionView
                    x:Name="UnidadesCollection"
                    Grid.Row="2"
                    SelectionMode="Single"
                    SelectionChanged="OnSelecaoChanged"
                    EmptyView="Nenhuma unidade cadastrada"
                    HeightRequest="150"
                    VerticalOptions="Start">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="60,*" Padding="0,8">
                                <Label Text="{Binding Id}" />
                                <Label Grid.Column="1" Text="{Binding Nome}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <Border
            x:Name="DadosFormulario"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Padding="16"
            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSurface}}">
            <VerticalStackLayout Spacing="16">
                <Label
                    Text="Dados da unidade"
                    Style="{StaticResource SubHeadline}"
                    HorizontalOptions="Start"
                    HorizontalTextAlignment="Start"
                    SemanticProperties.HeadingLevel="Level2" />

                <Grid x:Name="Linha1" ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                        <Label Text="Nome Fantasia" />
                        <Entry
                            x:Name="NomeEntry"
                            Placeholder="Nome Fantasia" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                        <Label Text="Razão Social" />
                        <Entry
                            x:Name="RazaoSocialEntry"
                            Placeholder="Razão Social" />
                    </VerticalStackLayout>
                </Grid>

                <Grid x:Name="Linha2" ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="CNPJ" />
                        <Entry
                            x:Name="CNPJEntry"
                            Placeholder="CNPJ" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="Insc. Estadual" />
                        <Entry
                            x:Name="IEEntry"
                            Placeholder="Insc. Estadual" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="2" Spacing="2">
                        <Label Text="Insc. Municipal" />
                        <Entry
                            x:Name="IMEntry"
                            Placeholder="Insc. Municipal" />
                    </VerticalStackLayout>
                </Grid>

                <Grid x:Name="Linha3" ColumnDefinitions="1*,3*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                        <Label Text="CEP" />
                        <Entry
            x:Name="CEPEntry"
            Placeholder="CEP"
            HorizontalOptions="Start"
            WidthRequest="120" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                        <Label Text="Logradouro" />
                        <Entry
            x:Name="LogradouroEntry"
            Placeholder="Logradouro"
            HorizontalOptions="Fill" />
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="3">
                   
                </VerticalStackLayout>


                <HorizontalStackLayout Spacing="12">
                    <Label
                        Text="Ativo"
                        VerticalOptions="Center" />
                    <Switch
                        x:Name="AtivoSwitch"
                        IsToggled="True"
                        Toggled="OnAtivoToggled" />
                    <Label
                        x:Name="AtivoStatusLabel"
                        Text="Ativo"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
                
                
                
                
                

                <Grid
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="12"
                    Margin="0,8,0,0">
                    <Button
                        Grid.Column="0"
                        x:Name="IncluirBtn"
                        Text="Incluir"
                        Clicked="OnIncluirClicked"
                        SemanticProperties.Hint="Prepara uma nova unidade para cadastro" />
                    <Button
                        Grid.Column="1"
                        x:Name="SalvarBtn"
                        Text="Salvar"
                        Clicked="OnSalvarClicked"
                        SemanticProperties.Hint="Salva a unidade informada" />
                    <Button
                        Grid.Column="2"
                        x:Name="CancelarBtn"
                        Text="Cancelar"
                        Clicked="OnCancelarClicked"
                        SemanticProperties.Hint="Cancela a edição e limpa o formulário" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
