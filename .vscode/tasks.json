{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "dotnet watch run",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/DialcronSB/DialcronSB.csproj",
                "-f",
                "net10.0-windows10.0.19041.0"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "isBackground": true
        }
    ]
}
